FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      HFDIBDEMDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

bodyNames ( "sphereFalling" );
interpolationSchemes
{
  U cell;
}

surfaceThreshold    1e-4;
stepDEM     0.1;
geometricD (1 1 1);
recordSimulation true;
recordFirstTimeStep true;
nSolidsInDomain -1;

outputSetup
{
    basic false;
    iB  false;
    DEM false;
    addModel false;
    parallelDEM false;
    statistics true;
}
sphereFalling
{

	fullyCoupledBody;
	
    // staticBody;

	rho         rho [1 -3 0 0 0 0 0] 945;
    
	U
	{
	BC  noSlip;
	}

	bodyAddition
	{
		addModel onceScatter;
		onceScatterCoeffs
		{
			addMode fieldBased;
			fieldBasedCoeffs
			{
				fieldName lambda;
				fieldValue 0.1;
			}
			addDomain boundBox;
			boundBoxCoeffs
			{
				minBound (-0.015 -0.03 -0.005);
				maxBound (0.015 0.03 0.005);
			}
			
			scalingMode    noScaling;
			noScalingCoeffs{}
			
			rotationMode   randomRotation;
			randomRotationCoeffs{}
		}
	}	
    material particle;
	//bodyGeom nonConvex;
    bodyGeom sphere;
	sphere
	{
	    startPosition   (0.0 0.02 0.0);
	    radius  0.0009;
	}
	updateTorque true;
	sdBasedLambda false;
	interfaceSpan 1.0;
	startSynced false;
	refineBuffers 0;
	timesToSetStatic -1;
}



