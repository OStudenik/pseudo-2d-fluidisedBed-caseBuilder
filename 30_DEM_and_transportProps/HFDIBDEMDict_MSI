FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      HFDIBDEMDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

bodyNames ( "sphereFalling" );
interpolationSchemes
{
  U cell;
}

surfaceThreshold    1e-4;
stepDEM     0.1;
geometricD (1 1 1);
recordSimulation true;
recordFirstTimeStep true;
nSolidsInDomain 170;

outputSetup
{
    basic false;
    iB  false;
    DEM false;
    addModel false;
    parallelDEM false;
    statistics true;
}
DEM
{
    LcCoeff 0.55;

    materials
    {
        particle     
        {
            Y       5e7;
            nu      0.5;
            mu      0.1;
            adhN    0;
            eps     0.75;
        }

        
        wall
        {
            Y       5e7;
            nu      0.5;
            mu      0.1;
            adhN    0;
            eps     0.75;
        }   
    }

    collisionPatches
    {
       bot
       {
           material wall;
           nVec (0 -1.0 0);
           planePoint (0.0 -0.03 0.0);
       }	
       top
       {
           material wall;
           nVec (0 1.0 0);
           planePoint (0.0 0.21 0.0);
       }	
       fixedWall3
       {
           material wall;
           nVec (0 0 -1.0);
           planePoint (0.0 0.00 -0.0025);
       }
       fixedWall4
       {
           material wall;
           nVec (0 0 1.0);
           planePoint (0.0 0.00 0.0025);
       }       
    }

    cyclicPatches
    {
       fixedWall1
       {
           nVec (1.0 0 0);
           planePoint (0.0075 0.00 0.0);
           neighbourPatch fixedWall2;
       }
       fixedWall2
       {
           nVec (-1.0 0 0);
           planePoint (-0.0075 0.00 0.0);
           neighbourPatch fixedWall1;
       }
    }
}

sphereFalling
{

	fullyCoupledBody
	{
		velocity (0 0 0);
	}

	rho         rho [1 -3 0 0 0 0 0] 945;

	U
	{
	BC  noSlip;
	}

	bodyAddition
	{
		addModel onceScatter;
		onceScatterCoeffs
		{
			addMode fieldBased;
			fieldBasedCoeffs
			{
				fieldName lambda;
				fieldValue 0.1;
			}
			addDomain boundBox;
			boundBoxCoeffs
			{
				minBound (-0.015 -0.03 -0.005);
				maxBound (0.015 0.03 0.005);
			}
			
			scalingMode    noScaling;
			noScalingCoeffs{}
			
			rotationMode   randomRotation;
			randomRotationCoeffs{}
		}
	}	
    material particle;

    bodyGeom sphere;
	sphere
	{
	    startPosition   (0.0 0.02 0.0);
	    radius  0.0009;
	}
	updateTorque true;
	sdBasedLambda false;
	interfaceSpan 1.0;
	startSynced false;
	refineBuffers 0;
	timesToSetStatic -1;
}


