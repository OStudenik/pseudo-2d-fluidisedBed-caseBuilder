FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      HFDIBDEMDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

bodyNames ( "sphereFalling" );

interpolationSchemes
{
  U cell;
}

surfaceThreshold    1e-4;
stepDEM     1;
geometricD (1 1 1);
recordSimulation true;
recordFirstTimeStep true;
nSolidsInDomain -1;

outputSetup
{
    basic false;
    iB  false;
    DEM false;
    addModel false;
    parallelDEM false;
    statistics true;
}
DEM
{
    LcCoeff 0.55;
    materials
    {
        particle
        {
            Y       1e7;
            nu      0.3;
            mu      0.05;
            adhN    0;
            eps     1;
        }

        wall
        {
            Y       1e7;
            nu      0.2;
            mu      0;
            adhN    0;
            eps     1;
        }
    }

    collisionPatches
    {
                wall0
                {
                        material wall;
                        nVec (-1.0 0.0 0.0);
                        planePoint (-0.0025 1.0 0);
                }
                wall1
                {
                        material wall;
                        nVec (1.0 0.0 0.0);
                        planePoint (0.0025 1.0 0);
                }
                wall2
                {
                        material wall;
                        nVec (0.0 0.0 1.0);
                        planePoint (0 1.0 0.0025);
                }

                wall3
                {
                        material wall;
                        nVec (0.0 0.0 -1.0);
                        planePoint (0 1.0 -0.0025);
                }

                wall4
                {
                        material wall;
                        nVec (0.0 -1.0 0.0);
                        planePoint (0 0 0);
                }
                wall5
                {
                        material wall;
                        nVec (0.0 1.0 0.0);
                        planePoint (0 2.0 0);
                }
    }
}

sphereFalling
{

    fullyCoupledBody;

    rho         rho [1 -3 0 0 0 0 0] 945;

    U
    {
            BC  noSlip;
    }

    bodyAddition
    {
        addModel once;
        onceCoeffs{}
    }

    material particle;
    
    bodyGeom sphere;
    sphere
    {
        radius 0.0009;
        startPosition (0.0 1.998 0.0);
    }
    // updateTorque false;
    updateTorque true;
    sdBasedLambda false;
    interfaceSpan 1.0;
    startSynced false;
    refineBuffers -1;
    timesToSetStatic -1;

}


