application     pimpleHFDIBFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         6.00;

deltaT          1e-8;

writeControl    adjustableRunTime;

writeInterval   5e-3;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression uncompressed;

timeFormat      general;

timePrecision   8;

maxCo           0.75;

maxDeltaT       0.0001;

adjustTimeStep  yes;

runTimeModifiable yes;

// runTime postprocessing

samplingTime    5e-4;
sampledFields   (p U lambda);

