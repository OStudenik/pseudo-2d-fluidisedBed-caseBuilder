FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    outlet
    {
        type            zeroGradient;
    }

    inlet
    {
        type            fixedValue;
        value           uniform (0.0 1.68 0);
    }

	front
	{
        type            noSlip;
	}

    left
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    back
    {
        type            symmetryPlane;
    }

}
