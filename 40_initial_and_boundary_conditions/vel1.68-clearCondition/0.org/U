FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 1.68 0);

boundaryField
{
  outlet
  { 
        type            zeroGradient;
  }   

  back
  {
        type            symmetryPlane;
  }
  
  front
  {
        type            noSlip;
  }  

  right
  {
        type            cyclic;
  }

  left
  {
        type            cyclic;
  }
  
  inlet
  {
        type            fixedValue;
        value           $internalField;
        // value           uniform (0 1.68 0);
  }

}

